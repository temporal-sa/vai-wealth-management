{
  "name": "empty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "vai": "ts-node src/vai_supervisor/main.ts",
    "temporal:worker": "ts-node src/temporal_supervisor/worker.ts",
    "temporal:worker.watch": "nodemon src/temporal_supervisor/worker.ts",
    "start": "ts-node src/temporal_supervisor/worker.ts",
    "start.watch": "nodemon src/temporal_supervisor/worker.ts",
    "codec-server": "ts-node src/temporal_supervisor/codec_server.ts",
    "api": "ts-node src/api/server.ts",
    "api.watch": "nodemon src/api/server.ts",
    "test": "mocha --exit --require ts-node/register --require source-map-support/register src/temporal_supervisor/mocha/*.test.ts",
    "compliance.approval": "ts-node src/temporal_supervisor/run_send_compliance_approval.ts"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.63",
    "@temporalio/activity": "^1.16.0",
    "@temporalio/client": "^1.16.0",
    "@temporalio/envconfig": "^1.16.0",
    "@temporalio/worker": "^1.16.0",
    "@temporalio/workflow": "^1.16.0",
    "@types/ioredis": "^4.28.10",
    "ai": "^6.0.159",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "nanoid": "3.x",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.16.0",
    "@tsconfig/node20": "^20.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "8.x",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "mocha": "8.x",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
